# Optional. Guided retail investigations work without model configuration.
# Copy to .env, configure locally, then restart npm start.
# Use a chat-completions endpoint supporting function tools.
# No credentials belong in frontend code or Git.
RETAIL_LLM_BASE_URL=
RETAIL_LLM_MODEL=
RETAIL_LLM_API_KEY=
# Base URL includes /v1 when required by your provider, with no /chat/completions suffix.
