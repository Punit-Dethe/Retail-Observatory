{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 180,
      "excludeFiles": "{node_modules/**,dist/**,src/**,references/**,.git/**,.env,.env.*,data/raw/**,data/retail.sqlite*,scripts/**,docs/**,.impeccable/**,**/__pycache__/**,**/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    { "source": "/canvas", "destination": "/index.html" },
    { "source": "/canvas/:path*", "destination": "/index.html" }
  ]
}
