      "css": ".ds-primary{font-family:'DM Sans Variable','DM Sans',sans-serif;background:var(--ink,#202521);color:#fff;border:1px solid var(--ink,#202521);border-radius:25px;padding:10px 15px;font-size:11px;line-height:17px;font-weight:500;cursor:pointer;transition:background .16s,color .16s,box-shadow .16s}.ds-primary:hover{background:#3b453c;color:#fff}.ds-primary:focus-visible{outline:2px solid var(--blue,#3974bd);outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
